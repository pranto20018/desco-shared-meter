# ─────────────────────────────────────────────────────────────
#  DESCO Meter Billing — Environment Variables
#  Copy to .env.local for local dev; set the same keys in
#  Netlify → Site settings → Environment variables for production.
# ─────────────────────────────────────────────────────────────

# Turso / libSQL database URL. Must be libsql:// — the app talks to Turso over
# HTTP so that it runs inside a Netlify Function, and that client cannot open a
# local file. Use a Turso database for local development as well.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io

# Turso auth token (turso db tokens create your-db-name)
TURSO_AUTH_TOKEN=eyJhbGciOi...

# Admin portal passcode. Long & random. Change before deploying.
ADMIN_SECRET_KEY=change-this-to-a-long-random-admin-secret

# Session cookie signing secret — min 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-64-char-hex-string-generated-randomly
